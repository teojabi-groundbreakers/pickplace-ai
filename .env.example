# Internal API. Set a secret through your environment, never commit a real value.
PICKPLACE_API_KEY=
PICKPLACE_REQUIRE_API_KEY=false
PICKPLACE_MODEL_DIR=artifacts/current
# Both flags must be explicitly enabled for local synthetic demonstrations.
PICKPLACE_ALLOW_SYNTHETIC=false
PICKPLACE_ALLOW_EXPERIMENTAL=false
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1

# 서울 열린데이터광장 API 수집 키. 실제 값은 로컬 환경에서만 설정한다.
SEOUL_OPEN_DATA_API_KEY=

# 2026Q2 model research-only service; set a separate local key securely.
PICKPLACE_NEAR_TERM_API_KEY=
# Optional absolute host path to the trusted research model bundle.
# PICKPLACE_NEAR_TERM_MODEL_SOURCE=/path/to/trusted/model-directory
