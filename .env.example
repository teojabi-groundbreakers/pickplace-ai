# Internal API. Set a secret through your environment, never commit a real value.
PICKPLACE_API_KEY=
PICKPLACE_REQUIRE_API_KEY=false
PICKPLACE_MODEL_DIR=artifacts/current
# Both flags must be explicitly enabled for local synthetic demonstrations.
PICKPLACE_ALLOW_SYNTHETIC=false
PICKPLACE_ALLOW_EXPERIMENTAL=false
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
